1)PROGRAM:
//to find the physical address from the locical address
#include <stdio.h>
int main() {
    int base, limit, logical, physical;
    printf("Enter Base Register: ");
    scanf("%d", &base);
    printf("Enter Limit Register: ");
    scanf("%d", &limit);
    printf("Enter Logical Address: ");
    scanf("%d", &logical);
    if (logical >= 0 && logical < limit) {
    //physical address=base+logical and only valid if logic is less than the limit
        physical = base + logical;
        printf("Valid Logical Address\n");
        printf("Physical Address = %d\n", physical);
    } else {
        printf("Invalid Logical Address! Memory Access Denied.\n");
    }

    return 0;
}

OUTPUT:
Enter Base Register: 10
Enter Limit Register: 1000
Enter Logical Address: 20
Valid Logical Address
Physical Address = 30

2)PROGRAM:

#include <stdio.h>
int main() {
    int pageTable[20];
    int n, page, offset, frame, pageSize;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter page size: ");
    scanf("%d", &pageSize);
    printf("Enter frame number for each page:\n");
    for (int i = 0; i < n; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }
    printf("Enter Page Number: ");
    scanf("%d", &page);
    printf("Enter Offset: ");
    scanf("%d", &offset);
    if (page >= n || offset >= pageSize) {
        printf("Invalid Logical Address!\n");
    } else {
        frame = pageTable[page];
        printf("Frame Number = %d\n", frame);
        printf("Physical Address = %d\n", frame * pageSize + offset);
    }
    return 0;
}

OUPUT:
Enter number of pages: 3
Enter page size: 3
Enter frame number for each page:
Page 0 -> Frame: 3
Page 1 -> Frame: 4
Page 2 -> Frame: 2
Enter Page Number: 1
Enter Offset: 2
Frame Number = 4
Physical Address = 14



3)PROGRAM:
#include <stdio.h>
int main() {
    int pageTable[20];
    int n, pageSize;
    int logicalAddress;
    int pageNumber, offset;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter page size: ");
    scanf("%d", &pageSize);
    printf("Enter frame numbers:\n");
    for (int i = 0; i < n; i++) {
        printf("Frame for Page %d: ", i);
        scanf("%d", &pageTable[i]);
    }
    printf("Enter Logical Address: ");
    scanf("%d", &logicalAddress);
    pageNumber = logicalAddress / pageSize;
    offset = logicalAddress % pageSize;
    if (pageNumber >= n) {
        printf("Invalid Logical Address!\n");
    } else {
        printf("\nPage Number = %d", pageNumber);
        printf("\nOffset = %d", offset);
        printf("\nFrame Number = %d", pageTable[pageNumber]);
        printf("\nPhysical Address = %d\n",
               pageTable[pageNumber] * pageSize + offset);
    }
    return 0;
}
OUTPUT:
Enter number of pages: 3
Enter page size: 5
Enter frame numbers:
Frame for Page 0: 4
Frame for Page 1: 5
Frame for Page 2: 3
Enter Logical Address: 10

Page Number = 2
Offset = 0
Frame Number = 3
Physical Address = 15


4)PROGRAM:
#include <stdio.h>
int main() {
    float memoryAccessTime;
    float tlbAccessTime;
    float hitRatio;
    float withoutTLB, withTLB;
    printf("Enter Memory Access Time (ns): ");
    scanf("%f", &memoryAccessTime);
    printf("Enter TLB Access Time (ns): ");
    scanf("%f", &tlbAccessTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);
    withoutTLB = 2 * memoryAccessTime;
    withTLB = hitRatio * (tlbAccessTime + memoryAccessTime)
            + (1 - hitRatio) * (tlbAccessTime + 2 * memoryAccessTime);
    printf("\nMemory Access Time without TLB = %.2f ns\n", withoutTLB);
    printf("Effective Memory Access Time with TLB = %.2f ns\n", withTLB);
    return 0;
}

OUPUT:
Enter Memory Access Time (ns): 10
Enter TLB Access Time (ns): 5
Enter TLB Hit Ratio (0 to 1): 2

Memory Access Time without TLB = 20.00 ns
Effective Memory Access Time with TLB = 5.00 ns

5)PROGRAM:

#include <stdio.h>
int main() {
    int base, limit, logicalAddress;
    printf("Enter Base Register: ");
    scanf("%d", &base);
    printf("Enter Limit Register: ");
    scanf("%d", &limit);
    printf("Enter Logical Address: ");
    scanf("%d", &logicalAddress);
    if (logicalAddress >= 0 && logicalAddress < limit) {
        printf("Access Granted.\n");
    //physical address=base+logical and only valid if logic is less than the limit
        printf("Physical Address = %d\n", base + logicalAddress);
    } else {
        printf("Access Denied! Address outside valid range.\n");
    }
    return 0;
}

OUTPUT:
Enter Base Register: 10
Enter Limit Register: 40
Enter Logical Address: 20
Access Granted.
Physical Address = 30
